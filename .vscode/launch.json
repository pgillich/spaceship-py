{
    // Use IntelliSense to learn about possible attributes.
    // Hover to view descriptions of existing attributes.
    // For more information, visit: https://go.microsoft.com/fwlink/?linkid=830387
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Python Debugger: Current File",
            "type": "debugpy",
            "request": "launch",
            "program": "${file}",
            "console": "integratedTerminal"
        },
        {
            "name": "Solar System",
            "type": "debugpy",
            "request": "launch",
            "module": "solar_system.main",
            "cwd": "${workspaceFolder}",
            "console": "integratedTerminal"
        },
        {
            "name": "Solar System: visualize",
            "type": "debugpy",
            "request": "launch",
            "module": "solar_system.visualize",
            "cwd": "${workspaceFolder}",
            "console": "integratedTerminal"
        },
    ]
}